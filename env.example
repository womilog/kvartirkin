# ===========================================================================
# Kvartirkin environment variables.
# Copy this file to .env and fill in real values:
#   cp env.example .env       (Linux/macOS)
#   copy env.example .env     (Windows)
# NEVER commit the real .env file (it is gitignored).
# ===========================================================================

# --- Core Django ---------------------------------------------------------
# Generate a new secret key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value

# Must be False in production!
DEBUG=False

# Comma-separated list of hostnames/IPs that serve the site.
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,127.0.0.1

# Full origins for CSRF (needed for HTTPS forms / admin). Comma-separated.
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- HTTPS / security ----------------------------------------------------
# If you serve plain HTTP (no TLS yet) set these to False, otherwise you
# will be redirected to https:// and get connection errors.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Raise once HTTPS is stable, e.g. 31536000 (1 year).
SECURE_HSTS_SECONDS=0

# --- Database (PostgreSQL) -----------------------------------------------
# The Postgres container reads DB_NAME / DB_USER / DB_PASSWORD to create the
# database on first boot. DB_HOST and DB_PORT are overridden by
# docker-compose to point at the "db" service, so leave them as-is here.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kvartirkin_db
DB_USER=kvartirkin
DB_PASSWORD=change-me-strong-password
# When running via docker compose these are set to db / 5432 automatically.
DB_HOST=db
DB_PORT=5432

# --- Email ---------------------------------------------------------------
# For real emails switch to the SMTP backend:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Address that receives booking requests.
LANDLORD_EMAIL=

# --- AI assistant (GigaChat) ---------------------------------------------
# Master switch. Set to 0 to disable the assistant entirely.
AI_ASSISTANT_ENABLED=1
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=
GIGACHAT_AUTH_URL=

# --- Gunicorn (optional tuning) ------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Set to 1 to load apartments/fixtures/initial_data.json on first boot.
LOAD_FIXTURES=0

# Set to 1 to import a full dump (db.json from `dumpdata`) into a FRESH
# database on first boot. Run once, then set back to 0.
LOAD_DB_JSON=0